{
  "schema": 1,
  "id": "personal",
  "name": "Personal",
  "config": {
    "categories": [
      {
        "id": "messages",
        "name": "Messages",
        "enabled": true,
        "patterns": [
          "mail.google.com",
          "outlook.live.com",
          "mail.yahoo.com",
          "mail.proton.me",
          "calendar.google.com",
          "web.whatsapp.com",
          "messenger.com",
          "discord.com"
        ]
      },
      {
        "id": "feeds",
        "name": "Feeds",
        "enabled": true,
        "patterns": [
          "reddit.com",
          "x.com",
          "bsky.app",
          "mastodon.social",
          "threads.net",
          "facebook.com",
          "instagram.com",
          "news.google.com",
          "apnews.com",
          "bbc.com",
          "nytimes.com",
          "youtube.com",
          "youtu.be",
          "twitch.tv",
          "netflix.com",
          "spotify.com"
        ]
      },
      {
        "id": "errands",
        "name": "Errands",
        "enabled": true,
        "patterns": [
          "amazon.com",
          "ebay.com",
          "etsy.com",
          "target.com",
          "walmart.com",
          "costco.com",
          "google.com/maps",
          "google.com/travel",
          "airbnb.com",
          "booking.com",
          "expedia.com",
          "kayak.com"
        ]
      },
      {
        "id": "random",
        "name": "Random",
        "enabled": true,
        "patterns": [],
        "catchAll": true
      }
    ],
    "settings": {
      "features": {
        "move": true,
        "dedupe": true,
        "sort": true
      },
      "moveDelayMin": 10,
      "dedupeIdleMin": 60,
      "sortMode": "rule",
      "sortFocusedWindow": false,
      "sortUnboundWindows": false,
      "createWindows": true,
      "autoBind": true,
      "respectTabGroups": true,
      "ignoreHashInDupes": true,
      "stripTrackingParams": true,
      "maxActionsPerTick": 40,
      "exclude": [
        "paypal.com",
        "title:Checkout",
        "title:Payment"
      ],
      "autoClose": {
        "enabled": true,
        "minutes": 10,
        "patterns": [
          "zoom.us/j/",
          "zoom.us/s/",
          "zoom.us/w/",
          "zoom.us/my/",
          "zoom.us/postattendee",
          "zoom.us/launch",
          "about:newtab",
          "*/whatsnew*"
        ]
      }
    }
  }
}
