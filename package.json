{
  "name": "ninetails",
  "version": "0.1.3",
  "private": true,
  "description": "Firefox extension that sorts tabs into named windows, closes idle duplicates and keeps windows in order. Local-only.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "web-ext run --source-dir extension",
    "sign": "web-ext sign --source-dir extension --artifacts-dir dist --channel unlisted"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  }
}
