{
  "schema": 1,
  "id": "work",
  "name": "Work",
  "config": {
    "categories": [
      {
        "id": "communication",
        "name": "Communication",
        "enabled": true,
        "patterns": [
          "mail.google.com",
          "outlook.office.com",
          "outlook.live.com",
          "calendar.google.com",
          "slack.com",
          "teams.microsoft.com",
          "chat.google.com",
          "meet.google.com",
          "calendly.com"
        ]
      },
      {
        "id": "projects",
        "name": "Projects",
        "enabled": true,
        "patterns": [
          "docs.google.com",
          "drive.google.com",
          "notion.so",
          "notion.site",
          "linear.app",
          "trello.com",
          "asana.com",
          "atlassian.net",
          "airtable.com",
          "office.com",
          "sharepoint.com",
          "dropbox.com",
          "github.com",
          "gitlab.com",
          "figma.com",
          "claude.ai",
          "chatgpt.com",
          "gemini.google.com"
        ]
      },
      {
        "id": "reading",
        "name": "Reading",
        "enabled": true,
        "patterns": [
          "file:///*.pdf*",
          "google.com/search",
          "https://www.google.*/search*",
          "bing.com/search",
          "duckduckgo.com/?q=",
          "wikipedia.org",
          "scholar.google.com",
          "arxiv.org",
          "pubmed.ncbi.nlm.nih.gov",
          "nature.com",
          "sciencedirect.com",
          "doi.org",
          "stackoverflow.com",
          "stackexchange.com",
          "readthedocs.io",
          "developer.mozilla.org",
          "medium.com",
          "substack.com",
          "youtube.com",
          "youtu.be"
        ]
      },
      {
        "id": "random",
        "name": "Random",
        "enabled": true,
        "patterns": [],
        "catchAll": true
      }
    ],
    "settings": {
      "features": {
        "move": true,
        "dedupe": true,
        "sort": true
      },
      "moveDelayMin": 10,
      "dedupeIdleMin": 60,
      "sortMode": "rule",
      "sortFocusedWindow": false,
      "sortUnboundWindows": false,
      "createWindows": true,
      "autoBind": true,
      "respectTabGroups": true,
      "ignoreHashInDupes": true,
      "stripTrackingParams": true,
      "maxActionsPerTick": 40,
      "exclude": [
        "paypal.com",
        "title:Checkout",
        "title:Payment"
      ],
      "autoClose": {
        "enabled": true,
        "minutes": 10,
        "patterns": [
          "zoom.us/j/",
          "zoom.us/s/",
          "zoom.us/w/",
          "zoom.us/my/",
          "zoom.us/postattendee",
          "zoom.us/launch",
          "about:newtab",
          "*/whatsnew*"
        ]
      }
    }
  }
}
